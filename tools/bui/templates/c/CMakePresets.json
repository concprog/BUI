{
  "version": 6,
  "configurePresets": [
    { "name": "default", "binaryDir": "${sourceDir}/build", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "binaryDir": "${sourceDir}/build-release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Debug", "targets": ["app"] },
    { "name": "release", "configurePreset": "release", "configuration": "Release", "targets": ["app"] }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "default" }
      ]
    }
  ]
}
